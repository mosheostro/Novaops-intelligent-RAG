# Secrets — .env.example stays tracked (the negation must come AFTER .env.*)
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/

# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Editors, OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Runtime logs (logs/eval.log + its rotated eval.log.1, eval.log.2, ... -- the
# directory is ignored outright since *.log alone would miss the rotated files)
logs/
*.log

# Local tool settings
.claude/settings.local.json

# Local working material kept on disk, never published
reference/
validate-lab/
PROMPT.md
CLAUDE.md-example
docs/code-reuse-analysis.md
