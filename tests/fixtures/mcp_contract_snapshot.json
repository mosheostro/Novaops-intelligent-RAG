  "server": {
    "name": "novaops-knowledge-base",
    "version": "0.2.0"
  },
  "tools": {
    "ask_rag": {
      "description": "Answer a question from the NovaOps knowledge base (employee handbook and, for the\nmanager role, the manager playbook), as the role this server was started with.\n`config` picks the retrieval configuration; `judge` adds LLM quality scores (slower);\n`updated_on_or_after` keeps only documents updated on or after that date.\nA first call after an idle period can take a while as the knowledge base warms up.",
      "input_schema": {
        "properties": {
          "config": {
            "default": "filter + rerank dynamic",
            "enum": [
              "baseline",
              "filter-only",
              "rerank-only",
              "filter + rerank static",
              "filter + rerank dynamic"
            ],
            "title": "Config",
            "type": "string"
          },
          "judge": {
            "default": false,
            "title": "Judge",
            "type": "boolean"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "updated_on_or_after": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional ISO date, YYYY-MM-DD (e.g. 2025-01-31). Keeps only documents updated on or after it.",
            "title": "Updated On Or After"
          }
        },
        "required": [
          "question"
        ],
        "title": "ask_ragArguments",
        "type": "object"
      },
      "output_schema": {
        "$defs": {
          "LiveJudgement": {
            "description": "Judge results for an ad-hoc question asked through the UI. `refused` is the\nOBSERVED behavior from the same refusal judge batch evaluation uses; there is\ndeliberately no refusal_ok, because a custom question has no expected\nbehavior to compare against.\n\n`completeness` is judged against the RETRIEVED CONTEXT\n(judges.context_completeness) \u2014 not against key_facts, which a custom\nquestion does not have \u2014 so it must never be mixed with\nContentEvaluation.completeness. It is None (not judged, no model call) when\nthere is no usable context: zero selected chunks, or a refusal.",
            "properties": {
              "completeness": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Completeness"
              },
              "completeness_reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Completeness Reason"
              },
              "context_relevance": {
                "title": "Context Relevance",
                "type": "number"
              },
              "context_relevance_reason": {
                "title": "Context Relevance Reason",
                "type": "string"
              },
              "faithfulness": {
                "title": "Faithfulness",
                "type": "number"
              },
              "faithfulness_reason": {
                "title": "Faithfulness Reason",
                "type": "string"
              },
              "refused": {
                "title": "Refused",
                "type": "boolean"
              }
            },
            "required": [
              "faithfulness",
              "faithfulness_reason",
              "context_relevance",
              "context_relevance_reason",
              "refused",
              "completeness",
              "completeness_reason"
            ],
            "title": "LiveJudgement",
            "type": "object"
          },
          "RetrievalInfo": {
            "properties": {
              "candidates_considered": {
                "title": "Candidates Considered",
                "type": "integer"
              }
            },
            "required": [
              "candidates_considered"
            ],
            "title": "RetrievalInfo",
            "type": "object"
          },
          "SecurityAuditView": {
            "description": "The public face of the domain SecurityAudit: whether it failed and how many\nsources it flagged \u2014 never which ones.",
            "properties": {
              "explanation": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Explanation"
              },
              "violating_source_count": {
                "title": "Violating Source Count",
                "type": "integer"
              },
              "violation": {
                "title": "Violation",
                "type": "boolean"
              }
            },
            "required": [
              "violation",
              "violating_source_count",
              "explanation"
            ],
            "title": "SecurityAuditView",
            "type": "object"
          },
          "SourceRef": {
            "description": "A selected chunk's provenance \u2014 never its text.",
            "properties": {
              "corpus": {
                "title": "Corpus",
                "type": "string"
              },
              "last_updated": {
                "title": "Last Updated",
                "type": "string"
              },
              "rank": {
                "title": "Rank",
                "type": "integer"
              },
              "rerank_score": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Rerank Score"
              },
              "source": {
                "title": "Source",
                "type": "string"
              },
              "subjects": {
                "items": {
                  "type": "string"
                },
                "title": "Subjects",
                "type": "array"
              }
            },
            "required": [
              "rank",
              "source",
              "corpus",
              "subjects",
              "last_updated",
              "rerank_score"
            ],
            "title": "SourceRef",
            "type": "object"
          }
        },
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "config": {
            "enum": [
              "baseline",
              "filter-only",
              "rerank-only",
              "filter + rerank static",
              "filter + rerank dynamic"
            ],
            "title": "Config",
            "type": "string"
          },
          "cutoff": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cutoff"
          },
          "judgement": {
            "anyOf": [
              {
                "$ref": "#/$defs/LiveJudgement"
              },
              {
                "type": "null"
              }
            ]
          },
          "planned_subjects": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned Subjects"
          },
          "retrieval": {
            "$ref": "#/$defs/RetrievalInfo"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "security_audit": {
            "$ref": "#/$defs/SecurityAuditView"
          },
          "sources": {
            "items": {
              "$ref": "#/$defs/SourceRef"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "enum": [
              "selected",
              "not_found"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "answer",
          "config",
          "role",
          "status",
          "planned_subjects",
          "cutoff",
          "retrieval",
          "sources",
          "security_audit",
          "judgement"
        ],
        "title": "AskRagResult",
        "type": "object"
      }
    },
