# Copy to .env and fill in the values. .env is git-ignored; never commit real credentials.
#   cp .env.example .env

# AWS credentials for the IAM user/role that can call Amazon Bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region of the Bedrock models AND the OpenSearch Serverless collection (they must match).
# Example: us-east-1
AWS_REGION=

# Bedrock chat model used for tagging, planning, reranking, answering and judging.
# Example: us.amazon.nova-2-lite-v1:0  (cross-region inference profile)
BEDROCK_MODEL_ID=

# Bedrock text-embedding model. Example: amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_MODEL_ID=

# Name of the existing OpenSearch Serverless collection; the endpoint is resolved from it.
OPENSEARCH_COLLECTION=

# Password for the Streamlit dashboard (ui/app.py) ONLY — required for every UI run,
# never needed by eval.py, the tests or the RAG modules. Put your real value in .env
# (locally) or in Streamlit Community Cloud Secrets (deployment); never commit it.
APP_PASSWORD=

# --- Optional -----------------------------------------------------------------
# Pin a specific collection endpoint and skip the name lookup.
# OPENSEARCH_ENDPOINT=

# Separate credentials for OpenSearch Serverless, when it lives in a different AWS
# account than Bedrock. Set BOTH or neither; when unset, the AWS_* keys are used.
# OPENSEARCH_AWS_ACCESS_KEY_ID=
# OPENSEARCH_AWS_SECRET_ACCESS_KEY=

#APP_PASSWORD=access PWD for UI
APP_PASSWORD=
